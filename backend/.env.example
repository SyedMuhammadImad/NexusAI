APP_ENV=development
CONTROL_TOKEN=

TRADING_MODE=paper
INITIAL_CAPITAL=100000
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

ORCHESTRATOR_MIN_FINAL_CONFIDENCE=0.60
ORCHESTRATOR_MIN_STRATEGY_CONFIDENCE=0.55
ORCHESTRATOR_MIN_CONFIRMATION_CONFIDENCE=0.52
ORCHESTRATOR_COOLDOWN_SECONDS=120.0

NEWS_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Optional Exness MT5 demo link.
# Demo trading is OFF unless TRADING_MODE=exness_demo and EXNESS_ENABLE_DEMO_TRADING=true.
# Install MetaTrader5 locally, open Exness MT5, then set these in backend/.env.
BROKER=exness_mt5
EXNESS_DEMO_LOGIN=
EXNESS_DEMO_PASSWORD=
EXNESS_DEMO_SERVER=
EXNESS_MT5_PATH=
EXNESS_SYMBOLS=XAUUSDm,EURUSDm,BTCUSDm,USOILm
EXNESS_TRADE_SYMBOLS=EURUSDm,USOILm,XAUUSDm
EXNESS_SYMBOL_MAP=BTC-USD:BTCUSDm,BTCUSD:BTCUSDm,ETH-USD:ETHUSDm,ETHUSD:ETHUSDm,EUR-USD:EURUSDm,EURUSD:EURUSDm,GBP-USD:GBPUSDm,GBPUSD:GBPUSDm,XAUUSD:XAUUSDm,GOLD:XAUUSDm,USOIL:USOILm,WTI:USOILm,XAUUSDm:XAUUSDm,EURUSDm:EURUSDm,BTCUSDm:BTCUSDm,USOILm:USOILm
EXNESS_ENABLE_DEMO_TRADING=false
EXNESS_ALLOW_MIN_VOLUME_ROUND_UP=false
EXNESS_MAX_ORDER_VOLUME=0.01
EXNESS_MAX_ORDER_RISK_USD=2.0
EXNESS_DEVIATION_POINTS=20
EXNESS_MARKET_DATA_INTERVAL=2.0
EXNESS_RECONCILE_INTERVAL=5.0

# Private local signal ingestion and journal.
# Keep these local. Do not publish private journals or broker credentials.
TRADE_JOURNAL_DB=
PRIVATE_ID_HASH_SALT=
IMAGE_SIGNAL_MIN_RISK_REWARD_RATIO=1.5
